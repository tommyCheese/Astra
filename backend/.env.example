DATABASE_URL=sqlite+aiosqlite:///./astra-dev.db
MODEL_PROVIDER=openai
MODEL_NAME=gpt-5
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
TOOL_WEB_SEARCH_ENABLED=true
TOOL_WEB_FETCH_ENABLED=true
TOOL_CHART_RENDER_ENABLED=true
WEB_SEARCH_PROVIDER=bing
WEB_SEARCH_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
GOOGLE_SEARCH_RESULT_COUNT=5
GOOGLE_SEARCH_LANGUAGE=lang_zh-CN
GOOGLE_SEARCH_REGION=
GOOGLE_SEARCH_SAFE=active
CRAWLER_MAX_CONTENT_CHARS=12000
CRAWLER_MAX_RESPONSE_BYTES=2097152
CRAWLER_MIN_QUALITY_CHARS=240
# Development-only compatibility for proxy DNS fake-IP mode (198.18.0.0/15).
CRAWLER_ALLOW_PROXY_FAKE_IP=false
AGENT_MAX_TURNS=12
AGENT_MAX_TOOL_CALLS=8
AGENT_PER_TOOL_RETRY_LIMIT=2
AGENT_MEMORY_WRITE_ENABLED=true
AGENT_USE_GENERAL_RUNTIME=true
AGENT_REASONING_SHADOW_MODE=false
AGENT_USE_LOOP=true
ALLOW_NETWORK_READ=true
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
SANDBOX_ENABLED=true
SANDBOX_PROVIDER=docker
SANDBOX_WEB_RUNTIME_IMAGE=astra-web-tools:0.1.0
SANDBOX_RUNTIME_IMAGE=astra-data-viz:0.1.0
RUNTIME_IMAGE_KEEP_RECENT=3
RUNTIME_IMAGE_RETENTION_DAYS=30
