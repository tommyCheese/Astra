# 数据库连接地址；默认使用 backend 目录下的本地 SQLite 数据库。
DATABASE_URL=sqlite+aiosqlite:///./astra-dev.db

# 默认模型供应商标识，例如 openai、anthropic、deepseek 或 mock。
MODEL_PROVIDER=openai
# 默认模型名称，必须是所选供应商支持的模型。
MODEL_NAME=gpt-5
# 默认模型 API Key；本地 mock 模式可以留空。
MODEL_API_KEY=
# 模型供应商的兼容 API 基础地址。
MODEL_BASE_URL=https://api.openai.com/v1

# 是否向 Agent 注册 Web Search 工具。
TOOL_WEB_SEARCH_ENABLED=true
# 是否向 Agent 注册 Web Fetch 工具。
TOOL_WEB_FETCH_ENABLED=true
# 是否向 Agent 注册隔离运行的图表渲染工具。
TOOL_CHART_RENDER_ENABLED=true
# 是否向 Agent 注册 Bash 命令工具；默认关闭以降低执行风险。
TOOL_BASH_EXECUTE_ENABLED=false
# 受信任工具供应商及其摘要白名单，多个条目使用逗号分隔。
TRUSTED_TOOL_PROVIDERS=astra.builtin=builtin
# 无人值守 Permission Bundle 的 HMAC 签名密钥；未配置时无人值守运行保持禁用。
PERMISSION_BUNDLE_SIGNING_SECRET=

# Web Search 供应商；auto 会按可用凭证选择，并允许无 Key 降级。
WEB_SEARCH_PROVIDER=auto
# 通用 Web Search API Key，供对应搜索供应商使用。
WEB_SEARCH_API_KEY=
# Google Custom Search API Key。
GOOGLE_SEARCH_API_KEY=
# Google Programmable Search Engine ID。
GOOGLE_SEARCH_ENGINE_ID=
# 每次 Google 搜索请求返回的最大结果数。
GOOGLE_SEARCH_RESULT_COUNT=5
# Google 搜索语言限制，例如 lang_zh-CN。
GOOGLE_SEARCH_LANGUAGE=lang_zh-CN
# Google 搜索区域代码；留空表示不限定区域。
GOOGLE_SEARCH_REGION=
# Google SafeSearch 级别，例如 active 或 off。
GOOGLE_SEARCH_SAFE=active

# 单个抓取结果保留的最大正文字符数。
CRAWLER_MAX_CONTENT_CHARS=12000
# 爬虫允许读取的最大 HTTP 响应字节数。
CRAWLER_MAX_RESPONSE_BYTES=2097152
# 判定页面具备有效正文所需的最少字符数。
CRAWLER_MIN_QUALITY_CHARS=240
# 是否允许开发代理使用 198.18.0.0/15 fake-IP；生产环境应保持关闭。
CRAWLER_ALLOW_PROXY_FAKE_IP=false

# 部署级 Agent Turn 硬上限；快速模式只受该上限约束。
AGENT_MAX_TURNS=60
# 部署级工具调用硬上限；快速模式只受该上限约束。
AGENT_MAX_TOOL_CALLS=50
# 单次 Run 允许的最大模型反思次数。
AGENT_MAX_REFLECTIONS=6
# 单次 Run 允许的最大重新规划次数。
AGENT_MAX_REPLANS=4
# 是否允许 Agent 将候选信息写入长期 Memory。
AGENT_MEMORY_WRITE_ENABLED=true
# 是否启用 Agent Loop；保留此开关用于部署级紧急控制。
AGENT_USE_LOOP=true
# 是否启用推理影子模式，仅记录推理策略而不影响主路径。
AGENT_REASONING_SHADOW_MODE=false
# 是否强制使用通用 Agent Runtime；关闭时当前执行路径不可用。
AGENT_USE_GENERAL_RUNTIME=true

# 是否允许网络读取类工具访问外部网络。
ALLOW_NETWORK_READ=true
# 允许访问后端的浏览器 Origin，多个地址使用逗号分隔。
CORS_ORIGINS=http://localhost:5173
# 本地单用户部署默认拒绝非 loopback API 客户端；仅在另有认证代理时启用。
API_ALLOW_REMOTE=false
# 服务日志级别，例如 DEBUG、INFO、WARNING 或 ERROR。
LOG_LEVEL=INFO

# Artifact 文件在宿主机上的存储目录。
ARTIFACT_STORE_PATH=./astra-artifacts
# 每个 Run 最多允许生成的 Artifact 文件数。
ARTIFACT_MAX_FILES=16
# 每个 Run 的 Artifact 总字节上限。
ARTIFACT_MAX_BYTES=20971520
# Artifact 的默认保留天数。
ARTIFACT_RETENTION_DAYS=30

# Task Workspace 在宿主机上的存储目录。
TASK_WORKSPACE_STORE_PATH=./astra-workspaces
# 单个 Task Workspace 允许保存的最大文件数。
TASK_WORKSPACE_MAX_FILES=10000
# 单个 Task Workspace 的总字节上限。
TASK_WORKSPACE_MAX_BYTES=1073741824
# Task Workspace 中单个文件的最大字节数。
TASK_WORKSPACE_MAX_FILE_BYTES=104857600

# 是否启用隔离 Sandbox Runtime。
SANDBOX_ENABLED=true
# 是否跳过启动时 Sandbox 可用性检查；仅建议测试环境使用。
SANDBOX_SKIP_AVAILABILITY_CHECK=false
# Sandbox Provider 类型；当前生产实现为 docker。
SANDBOX_PROVIDER=docker
# Docker CLI 可执行文件名称或绝对路径。
DOCKER_BINARY=docker
# 数据分析、图表与 Bash 工具使用的默认运行时镜像。
SANDBOX_RUNTIME_IMAGE=astra-data-viz:0.1.0
# Web Search 与 Web Fetch 使用的隔离运行时镜像。
SANDBOX_WEB_RUNTIME_IMAGE=astra-web-tools:0.1.0
# 默认 Sandbox 镜像的依赖锁摘要；未自定义时可以留空。
SANDBOX_RUNTIME_LOCK_DIGEST=
# 单个 Sandbox Job 的最大墙钟运行秒数。
SANDBOX_WALL_TIME_SECONDS=30
# 单个 Sandbox 容器的内存上限，单位为 MiB。
SANDBOX_MEMORY_MB=1024
# 单个 Sandbox 容器可使用的 CPU 核数。
SANDBOX_CPUS=1.0
# 单个 Sandbox 容器允许创建的最大进程数。
SANDBOX_PIDS=128
# Bash 工具返回给模型的最大输出字符数。
BASH_OUTPUT_MAX_CHARS=12000

# 自定义 Runtime Profile 状态文件路径。
RUNTIME_PROFILE_PATH=./runtime-profile.json
# 自定义运行时镜像构建的最大等待秒数。
RUNTIME_BUILD_TIMEOUT_SECONDS=600
# 除当前镜像外额外保留的最近自定义镜像数量。
RUNTIME_IMAGE_KEEP_RECENT=3
# 未使用自定义运行时镜像的保留天数。
RUNTIME_IMAGE_RETENTION_DAYS=30
