# Image version without the leading "v".
ASTRA_VERSION=0.1.0
ASTRA_REGISTRY=ghcr.io/tommycheese
ASTRA_PORT=8080

# install.sh replaces this with an absolute host path. Do not use a relative path:
# sandbox containers are created by the host Docker Engine and must see the same path.
ASTRA_DATA_DIR=/absolute/path/to/astra-data
DOCKER_SOCKET=/var/run/docker.sock

# Astra starts in deterministic mock mode. Set these values to use a real model.
MODEL_PROVIDER=mock
MODEL_NAME=mock-web-query
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1

# Keep shell execution disabled unless you explicitly need and trust it.
TOOL_BASH_EXECUTE_ENABLED=false
PERMISSION_BUNDLE_SIGNING_SECRET=
